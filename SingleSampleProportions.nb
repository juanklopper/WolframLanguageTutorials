Cell[CellGroupData[{

Cell[TextData[{
 "Confidence intervals, where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "1.96"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c=1.96", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0540b212-7a9a-43a9-9dbd-6a7f743f041b"],
 " is the confidence coefficient, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        OverscriptBox[
         StyleBox["p", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
      "\\hat{p}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "=", ".34"}], TraditionalForm]],ExpressionUUID->
  "e1526b28-6833-4692-bcd5-747dcc15c91e"],
 " is the sample proportion of adult smokers, and the confidence level is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "1", "-", "\[Alpha]", 
         "\[LongEqual]", "1", "-", ".05", "\[LongEqual]", ".95"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "L=1 - \\alpha = 1 - .05 = .95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "527476e9-98ac-45c6-9309-4652d9eaa4b9"],
 " (a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["95", TraditionalForm], "errors" -> {}, "input" -> 
     "95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4306fb26-c342-483d-8f30-68a909fdeb3a"],
 "% confidence interval)"
}], "Item",
 CellChangeTimes->{{4.001600365044938*^9, 4.001600407153948*^9}, {
  4.001600501358944*^9, 4.001600508452311*^9}, {4.0016005690380707`*^9, 
  4.0016006634190073`*^9}},ExpressionUUID->"8c56097f-40eb-4471-bbda-\
0dd8102d7b43"],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["p", "TI"], "^"], "\[PlusMinus]", 
         StyleBox["c", "TI"], 
         SqrtBox[
          FractionBox[
           RowBox[{
             OverscriptBox[
              StyleBox["p", "TI"], "^"], "(", 
             RowBox[{"1", "-", 
               OverscriptBox[
                StyleBox["p", "TI"], "^"]}], ")"}], 
           StyleBox["n", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{p} \\pm c \\sqrt{\\frac{\\hat{p} \\left( 1 - \\hat{p} \
\\right)}{n}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7f7417d-042d-48e5-84f6-1867802253e0"]
}], "Subitem",
 CellChangeTimes->{{4.001600365044938*^9, 4.001600407153948*^9}, {
  4.001600501358944*^9, 
  4.0016005236500998`*^9}},ExpressionUUID->"d1120004-213f-4692-a237-\
fa93472bf862"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "bounds", " ", "of", " ", "the", " ", "95", 
    "%", " ", "confidence", " ", "interval"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{".34", "-", 
    RowBox[{"(", 
     RowBox[{"1.96", " ", 
      SqrtBox[
       FractionBox[
        RowBox[{".34", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", ".34"}], ")"}]}], "100"]]}], ")"}]}], 
   RowBox[{"(*", 
    RowBox[{"Lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{".34", "+", 
    RowBox[{"(", 
     RowBox[{"1.96", " ", 
      SqrtBox[
       FractionBox[
        RowBox[{".34", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", ".34"}], ")"}]}], "100"]]}], ")"}], 
    RowBox[{"(*", 
     RowBox[{"Upper", " ", "bound"}], "*)"}]}]}]}]], "Input",
 CellChangeTimes->{{4.001600559349627*^9, 4.001600565586074*^9}, {
  4.0016006671679487`*^9, 4.0016007164309397`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"7c9b00fc-6c05-4199-82a5-153be96dda00"]
}, Open  ]],

Cell[TextData[{
 "We are ",
 Cell[BoxData[
  FormBox["95", TraditionalForm]],ExpressionUUID->
  "2bfdb080-4d62-4d51-aafa-eaaefe1e1da4"],
 "% confident that the true proportion of adults who smoke in this population \
is between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["24.7", TraditionalForm], "errors" -> {}, "input" -> 
     "24.7", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98d1f707-3e77-4582-8749-519a4ad5d53f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["43.3", TraditionalForm], "errors" -> {}, "input" -> 
     "43.3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd0cd57d-8d36-4a5c-85ec-9951c025a915"],
 "%. Since the proportion of smokers under the null hypothesis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "0"], "\[LongEqual]", ".3"}], TraditionalForm],
      "errors" -> {}, "input" -> "p_{0} = .3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "669d10cc-4878-45e5-847f-a3cca3777afd"],
 " is in this interval, we fail to reject the null hypothesis."
}], "Subitem",
 CellChangeTimes->{{4.001600723945059*^9, 
  4.001600819493314*^9}},ExpressionUUID->"d8f6ae60-baed-45b3-85b1-\
71cfe5adc28e"]
}, Open  ]]
}, Closed]]
}, Closed]],

