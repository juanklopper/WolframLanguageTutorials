         RowBox[{
           OverscriptBox[
            StyleBox["p", "TI"], "^"], "-", 
           SubscriptBox[
            StyleBox["p", "TI"], "0"]}], 
         SqrtBox[
          FractionBox[
           RowBox[{
             SubscriptBox[
              StyleBox["p", "TI"], "0"], "(", 
             RowBox[{"1", "-", 
               SubscriptBox[
                StyleBox["p", "TI"], "0"]}], ")"}], 
           StyleBox["n", "TI"]]]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "Z = \\frac{\\hat{p} - p_{0}}{\\sqrt{\\frac{p_{0} \\left( 1 - p_{0} \
\\right)}{n}}}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"134c67af-5615-4ab1-9fef-4d3fb9b28f1e"]], \
