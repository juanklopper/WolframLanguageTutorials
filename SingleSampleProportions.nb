Cell[CellGroupData[{

Cell["TESTS FOR SINGLE SAMPLE PROPORTIONS", "Title",
 CellChangeTimes->{{4.001596494048483*^9, 
  4.001596500663409*^9}},ExpressionUUID->"37a2e3d3-98f3-48d5-aeb4-\
9dace6c70cca"],

Cell["DR JHK", "Subtitle",
 CellChangeTimes->{{4.0015965065131187`*^9, 
  4.0015965076401176`*^9}},ExpressionUUID->"c79b5464-dee8-4feb-b743-\
6cb1e0f1a281"],

Cell[CellGroupData[{

Cell["INTRODUCTION", "Section",
 CellChangeTimes->{{4.001596510746483*^9, 
  4.001596512784799*^9}},ExpressionUUID->"a4beaf3a-f4f3-4299-b461-\
61ac6f0488de"],

Cell[CellGroupData[{

Cell["Consider variables with a categorical level of measurement", "Item",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598699361586*^9}, {
  4.0018457140196123`*^9, 
  4.001845714021366*^9}},ExpressionUUID->"c2bfe9fd-2a7a-4a99-8fca-\
55f4cde40453"],

Cell["\<\
A variable with a categorical level of measurements has defined categories \
(levels / sample space elements)\
\>", "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598699361586*^9}, {
  4.0018457156935663`*^9, 4.0018457528880787`*^9}, {4.001845800972392*^9, 
  4.001845800974331*^9}, {4.001862250642777*^9, 4.00186225238653*^9}, {
  4.0019285925170727`*^9, 
  4.00192859608582*^9}},ExpressionUUID->"6f831ba8-d5ad-4f88-91f6-\
ea861777cbd4"],

Cell["We cant count the number of observations of each category", "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598699361586*^9}, {
  4.0018457156935663`*^9, 4.0018457528880787`*^9}, {4.001845802632452*^9, 
  4.001845829488936*^9}},ExpressionUUID->"9653075f-db67-4d1a-969b-\
7660c9346fde"],

Cell["\<\
We can calculate the relative frequency (proportion) of each category\
\>", "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598699361586*^9}, {
  4.0018457156935663`*^9, 4.0018457528880787`*^9}, {4.001845802632452*^9, 
  4.001845867343978*^9}},ExpressionUUID->"1e3dd900-7a05-4f1b-bc57-\
b57071f09929"],

Cell["Proportion = Probability", "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598699361586*^9}, {
  4.0018457156935663`*^9, 4.0018457528880787`*^9}, {4.001845802632452*^9, 
  4.0018458602967052`*^9}, {4.001862302500931*^9, 
  4.0018623025027647`*^9}},ExpressionUUID->"ec41864e-d5c0-4858-9dba-\
b6bc5e4d3670"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Make claims about the proportion of each category in the population\
\>", "Item",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598741229115*^9}, 
   4.001845876719577*^9},ExpressionUUID->"001b0813-83a8-4d83-a275-\
8b3de8adf43e"],

Cell[TextData[{
 "For binary categorical variables, label one category the ",
 StyleBox["success",
  FontSlant->"Italic"],
 " and the other the ",
 StyleBox["failure",
  FontSlant->"Italic"],
 ", then the probability of success in the population is ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "9464903f-1345-43dd-94d6-15e8912db9aa"],
 ", and the estimate is the sample proportion of success ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["p", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{p}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce5a074d-72d6-4532-b760-8513a44f61e9"],
 " (for the failure category, the probability would be would be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1-p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e4e089c-377a-4e14-937c-ce25424778db"],
 " in the population with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", 
         OverscriptBox[
          StyleBox["p", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1 - \\hat{p}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f97a42c1-acf2-4edd-9eff-232bc6d4f4e7"],
 " as estimate)"
}], "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598807622031*^9}, {
  4.001862341211646*^9, 4.001862422033751*^9}, {4.001928681510305*^9, 
  4.001928694737829*^9}, {4.001928766041429*^9, 
  4.00192876972626*^9}},ExpressionUUID->"99ebc213-95e4-438a-9e06-\
7b0b52791840"],

Cell[TextData[{
 "For multinomial categorical variables, we have the population proportion of \
each, e.g. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_{1}, p_{2},p_{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "404d5863-df38-480d-a306-c26ab107bbdd"],
 " and so on, with estimates being the sample proportions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["p", "TI"], "^"], "1"], ",", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["p", "TI"], "^"], "2"], ",", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["p", "TI"], "^"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat{p}_{1}, \\hat{p}_{2} , \\hat{p}_{3}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2b64c8f-6702-4fd5-b9d9-3f41269b5c2a"],
 " and so on"
}], "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 
  4.001598902225933*^9}},ExpressionUUID->"67c71bab-250e-4197-b985-\
3dc0f204c74f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hypothesis tests", "Item",
 CellChangeTimes->{{4.001598677221224*^9, 4.001598913612315*^9}, {
  4.001845895432959*^9, 
  4.001845910408368*^9}},ExpressionUUID->"6bf15ea8-4fbd-4fe5-9a10-\
9321ee46dd02"],

Cell[TextData[{
 "One-sample ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["Z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "Z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1be2ac8-d2df-4c9e-80c3-2ecbfabe13f6"],
 "-test for proportions"
}], "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 
  4.001598913612315*^9}},ExpressionUUID->"889f0266-9fe8-4ecb-bc37-\
fa63b6289c67"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Chi]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi^{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "baf88189-317b-4a74-a273-aac05f56e031"],
 " goodness of fit test"
}], "Subitem",
 CellChangeTimes->{{4.001598677221224*^9, 
  4.001598923435088*^9}},ExpressionUUID->"f88779b8-0c5a-458d-b7f1-\
00292dc158df"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "INTUITION FOR ONE-SAMPLE ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["Z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "Z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b62df058-ab9c-4323-91b8-9854fd140d99"],
 " TEST FOR PROPORTIONS"
}], "Section",
 CellChangeTimes->{{4.00159657716667*^9, 4.0015965839162617`*^9}, {
  4.001597890029395*^9, 4.001597904566258*^9}, {4.001604290485342*^9, 
  4.001604292901572*^9}},ExpressionUUID->"81e70a14-0c53-4feb-a986-\
ae292e237cad"],

Cell[TextData[{
 "This test is for claims about the proportion of successes in a population, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "661f2635-ebf5-49a2-9eaa-444f3b6f503f"]
}], "Item",
 CellChangeTimes->{{4.001598616287171*^9, 4.001598668532958*^9}, {
  4.001598898262631*^9, 
  4.001598898849852*^9}},ExpressionUUID->"8c4db341-0521-4eaf-bcaa-\
91b63d823cd4"],

Cell[TextData[{
 "Generate a population where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", ".5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p=.5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81a4115c-6c59-43cb-ac43-5f35271fec7e"]
}], "Item",
 CellChangeTimes->{{4.001598616287171*^9, 4.001598620490168*^9}, {
  4.001598655678896*^9, 4.001598660475815*^9}, {4.001845994118738*^9, 
  4.001845994178278*^9}},ExpressionUUID->"7cd40e75-34d9-4186-b21b-\
efda6ff6b610"],

Cell[TextData[{
 "Sample ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["100", TraditionalForm], "errors" -> {}, "input" -> 
     "100", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ca169fd-3221-4f92-b202-2ea9c08e2b39"],
 " observations from the population calculate the proportions of successes"
}], "Item",
 CellChangeTimes->{{4.001598616287171*^9, 4.001598620490168*^9}, {
  4.001598655678896*^9, 4.001598660475815*^9}, {4.001846000366972*^9, 
  4.001846025392721*^9}},ExpressionUUID->"f01d80cb-4902-4039-9c06-\
62b22d8c144c"],

Cell[CellGroupData[{

Cell[TextData[{
 "Repeat this experiment ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
