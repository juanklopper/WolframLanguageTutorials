Cell[TextData[{
 "Researchers claim that the population proportion of adults who currently \
smoke in a specific community is not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["30", TraditionalForm], "errors" -> {}, "input" -> 
     "30", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d166009-56a7-4819-9f10-2a3aaec07557"],
 "% ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["p", "TI"], "0"], "\[LongEqual]", ".3"}], ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
