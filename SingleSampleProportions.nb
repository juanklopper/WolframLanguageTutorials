Cell[CellGroupData[{

Cell[TextData[{
 "We can fit a model (for the sample proportion of successes, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["p", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{p}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f95ee05-6ccd-4de4-ae1a-d08cfeb4a4fc"],
 ", as the estimate for the population proportion of success, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ccc723b5-66ae-4c52-bdf4-58f487c3b80e"],
 ") where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["p", "TI"], "^"], "\[Tilde]", 
         StyleBox["N", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], ",", 
             FractionBox[
              RowBox[{
                StyleBox["p", "TI"], "(", 
                RowBox[{"1", "-", 
                  StyleBox["p", "TI"]}], ")"}], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\hat{p} \\sim \\mathrm{N} \\left( p, \\frac{p \\left( 1 - p \
\\right)}{n} \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b72176b2-b90d-4e6a-a691-3cc560b0f7c3"]
}], "Item",
 CellChangeTimes->{{4.0015972286348543`*^9, 4.0015972343701477`*^9}, {
  4.0015973004565363`*^9, 4.0015973454574747`*^9}, {4.0018461063305063`*^9, 
  4.001846106554982*^9}},ExpressionUUID->"17d081d8-bcab-4953-9850-\
f1c697c2bd6a"],

