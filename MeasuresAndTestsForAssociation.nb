  4.0023566706426477`*^9}},ExpressionUUID->"fa52c74d-ee75-49fd-aa34-\
014092b819f2"],

Cell[TextData[{
 "If the estimated relative risk is lower than ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ccb5e761-50c4-447d-a4cc-194bf67800e9"],
 ", we would use the following derivation (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["RR", "^"], "\[LongEqual]", "0.41"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\widehat{\\text{RR}} = 0.41", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b71b92bf-f9c2-47be-a10b-42f2ce9e1f81"],
 ")"
}], "Item",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.002189091430017*^9}, {
  4.0021891333*^9, 4.002189192068952*^9}, {4.002190378474248*^9, 
  4.002190461846044*^9}, {4.002356631066105*^9, 4.0023566365239487`*^9}, {
  4.002356671221382*^9, 
  4.0023567286572857`*^9}},ExpressionUUID->"1049f433-e5f7-41a8-a4f6-\
2e8340b523a4"],

Cell[BoxData[{
 RowBox[{
  FractionBox[
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", "E"}], ")"}]}], 
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}]], "=", ".41"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{".41", 
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", 
     OverscriptBox["E", "_"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", ".59"}], ")"}], 
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", 
     OverscriptBox["E", "_"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}], "-", 
   RowBox[{".59", 
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}]}]}]}], "DisplayFormula",
 CellChangeTimes->{{4.002356755856823*^9, 
  4.002356799771112*^9}},ExpressionUUID->"662fe87b-3fa0-42d5-a715-\
902fd2507f47"],

Cell[TextData[{
 "We would state that the exposure decreases the risk of disease by ",
 Cell[BoxData[
