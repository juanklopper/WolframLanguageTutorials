Cell[CellGroupData[{

Cell["ODDS RATIO", "Subsection",
 CellChangeTimes->{{4.002190690919023*^9, 
  4.002190692466199*^9}},ExpressionUUID->"fa247b6a-24a8-4b77-8781-\
249026f4e13b"],

Cell["Ratio of odds", "Item",
 CellChangeTimes->{{4.002205665608162*^9, 
  4.002205671909482*^9}},ExpressionUUID->"905d3ffe-3fd3-4210-94a7-\
56d420809f36"],

Cell[TextData[{
 "Odds is the ratio between the probability of success ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf927658-f1b7-47b7-ad64-5e4d95770320"],
 " and the probability of failure ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1-p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b4d9ee6-d3f2-4cbc-b307-d28547b4f329"],
 " (for a binary variable)"
}], "Item",
 CellChangeTimes->{{4.002205665608162*^9, 4.002205703492132*^9}, {
  4.002205765657277*^9, 4.00220576566394*^9}, {4.002356876068694*^9, 
  4.0023568832654943`*^9}},ExpressionUUID->"bec9bfc7-2cb3-44a9-ac38-\
9f11925b9e89"],

Cell["Odds of disease in the exposed", "Item",
 CellChangeTimes->{{4.002205665608162*^9, 4.002205703492132*^9}, {
  4.002205766827838*^9, 
  4.0022057721693773`*^9}},ExpressionUUID->"7ee348a2-a414-4508-864b-\
c3aad92a7a0a"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", "E"}], ")"}]}], 
   RowBox[{"1", "-", 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", "E"}], ")"}]}]}]], "=", 
  RowBox[{
   FractionBox[
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", "E"}], ")"}]}], 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["D", "_"], "|", "E"}], ")"}]}]], "=", 
   FractionBox[
    FractionBox[
     SubscriptBox["n", "11"], 
     SubscriptBox["n", 
      RowBox[{"1", "+"}]]], 
    FractionBox[
     SubscriptBox["n", "12"], 
     SubscriptBox["n", 
      RowBox[{"1", "+"}]]]]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002205781288464*^9, 
  4.002205891109424*^9}},ExpressionUUID->"6141991b-43e4-4cab-898a-\
c0183e75ce89"],

Cell["Odds of disease in the unexposed", "Item",
 CellChangeTimes->{{4.002205665608162*^9, 4.002205703492132*^9}, {
  4.002205766827838*^9, 4.0022057721693773`*^9}, {4.002205911249054*^9, 
  4.002205911429905*^9}},ExpressionUUID->"5c83f7c0-f141-4c90-a2f8-\
75652d85593b"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}], 
   RowBox[{"1", "-", 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", 
       OverscriptBox["E", "_"]}], ")"}]}]}]], "=", 
  RowBox[{
   FractionBox[
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", 
       OverscriptBox["E", "_"]}], ")"}]}], 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["D", "_"], "|", 
       OverscriptBox["E", "_"]}], ")"}]}]], "=", 
   FractionBox[
    FractionBox[
     SubscriptBox["n", "21"], 
     SubscriptBox["n", 
      RowBox[{"2", "+"}]]], 
    FractionBox[
     SubscriptBox["n", "22"], 
     SubscriptBox["n", 
      RowBox[{"2", "+"}]]]]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002205781288464*^9, 
  4.002205952228464*^9}},ExpressionUUID->"5136c915-fbf6-4e2f-98ff-\
7da1604794fe"],

Cell["\<\
Odds ratio (comparing odds of disease in exposed to odds of disease in \
unexposed)\
\>", "Item",
 CellChangeTimes->{{4.002205963169168*^9, 4.00220596541539*^9}, {
  4.002206089034506*^9, 
  4.002206106708695*^9}},ExpressionUUID->"dd6f06e8-2f8d-4540-ad35-\
480cb2f3470b"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   FractionBox[
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", "E"}], ")"}]}], 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["D", "_"], "|", "E"}], ")"}]}]], 
   FractionBox[
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", 
       OverscriptBox["E", "_"]}], ")"}]}], 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["D", "_"], "|", 
       OverscriptBox["E", "_"]}], ")"}]}]]], "=", 
  RowBox[{
   FractionBox[
    FractionBox[
     FractionBox[
      SubscriptBox["n", "11"], 
      SubscriptBox["n", 
       RowBox[{"1", "+"}]]], 
     FractionBox[
      SubscriptBox["n", "12"], 
      SubscriptBox["n", 
       RowBox[{"1", "+"}]]]], 
    FractionBox[
     FractionBox[
      SubscriptBox["n", "21"], 
      SubscriptBox["n", 
       RowBox[{"2", "+"}]]], 
     FractionBox[
      SubscriptBox["n", "22"], 
      SubscriptBox["n", 
       RowBox[{"2", "+"}]]]]], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      FractionBox[
       SubscriptBox["n", "11"], 
       SubscriptBox["n", 
        RowBox[{"1", "+"}]]], 
      FractionBox[
       SubscriptBox["n", "12"], 
       SubscriptBox["n", 
        RowBox[{"1", "+"}]]]], " ", 
     FractionBox[
      FractionBox[
       SubscriptBox["n", "22"], 
       SubscriptBox["n", 
        RowBox[{"2", "+"}]]], 
      FractionBox[
       SubscriptBox["n", "21"], 
       SubscriptBox["n", 
        RowBox[{"2", "+"}]]]]}], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox["n", "11"], 
      SubscriptBox["n", "22"]}], 
     RowBox[{
      SubscriptBox["n", "12"], 
      SubscriptBox["n", "21"]}]]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.0022059786231623`*^9, 
  4.002206077602064*^9}},ExpressionUUID->"b4192b15-b75e-4ecf-a3a7-\
0ca95f157536"],

Cell[CellGroupData[{

Cell["We calculate the estimated odds ratio", "Item",
 CellChangeTimes->{{4.0022061314560413`*^9, 
  4.002206137257889*^9}},ExpressionUUID->"0d0d1036-8368-461d-a485-\
2e132c24c0eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "estimated", " ", "odds", " ", "ratio", " ", 
    "form", " ", "the", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"orEstimate", "=", 
   RowBox[{"N", "[", 
    FractionBox[
     RowBox[{"101", " ", "98"}], 
     RowBox[{"23", " ", "21"}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0022061408215837`*^9, 4.002206195732493*^9}, {
  4.002206692307345*^9, 4.002206694162806*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"5fca9a6a-2038-4101-a00c-66c176cadea5"],

Cell[BoxData["20.492753623188406`"], "Output",
 CellChangeTimes->{4.002383226966325*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"cbc80903-ebff-406b-abfb-87685edd2c4e"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "We conclude that the odds of disease in the exposed is ",
 Cell[BoxData[
  FormBox["20.49", TraditionalForm]],ExpressionUUID->
  "21202866-0be6-4814-b8b6-d061f22763e7"],
 " times the odds of disease in the unexposed"
}], "Item",
 CellChangeTimes->{{4.002206206863077*^9, 4.0022062542470512`*^9}, {
  4.002206399845347*^9, 
  4.0022063998468103`*^9}},ExpressionUUID->"c7e6eff2-d107-4b3a-8c1f-\
c14690ae6579"],

Cell[TextData[{
 "The same argument holds as for the relative risk and we state that exposure \
increases the estimated odds of disease by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1949", TraditionalForm], "errors" -> {}, "input" -> 
     "1949", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e2668dd-5bf4-4e60-94ab-1ddd6c83d7f1"],
 "%"
}], "Item",
 CellChangeTimes->{{4.002206206863077*^9, 4.0022062542470512`*^9}, {
  4.002206401779482*^9, 
  4.002206445563344*^9}},ExpressionUUID->"1aff5745-0248-4f88-a4b3-\
25cfe4bda8e5"],

Cell[CellGroupData[{

Cell[TextData[{
 "We can calculate confidence intervals where where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "1.96"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c=1.96", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69252db5-2394-40ec-acda-3c2b7a40ac90"],
 " is the confidence coefficient for a confidence level of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", ".95"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L=.95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f6745b9-d790-4989-9563-e05ad0503cf3"]
}], "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.0021884439717417`*^9}, {
  4.002188594531001*^9, 4.002188614674968*^9}, {4.002188648110002*^9, 
  4.002188672018972*^9}, {4.002189977428075*^9, 
  4.002189982096168*^9}},ExpressionUUID->"8022e464-1f3f-4004-8ae6-\
f0453e410d1b"],

Cell["\<\
Unfortunately the estimated odds ratio is not normally distributed and we \
have to perform a log transformation\
\>", "Subitem",
 CellChangeTimes->{{4.002188315582061*^9, 4.0021884439717417`*^9}, {
  4.002188594531001*^9, 4.002188614674968*^9}, {4.002188648110002*^9, 
  4.002188672018972*^9}, {4.002189977428075*^9, 4.0021900049663887`*^9}, {
  4.002206498288109*^9, 
  4.0022065023367434`*^9}},ExpressionUUID->"32dd6115-1557-4db7-86d3-\
a2bbb610f3c9"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ln", 
   RowBox[{"(", 
    OverscriptBox["OR", "^"], ")"}]}], "\[PlusMinus]", 
  RowBox[{"c", 
   SqrtBox[
    RowBox[{
     FractionBox["1", 
      SubscriptBox["n", "11"]], "+", 
     FractionBox["1", 
      SubscriptBox["n", "12"]], "+", 
     FractionBox["1", 
      SubscriptBox["n", "21"]], "+", 
     FractionBox["1", 
      SubscriptBox["n", "22"]]}]]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002206522454844*^9, 
  4.0022065890621243`*^9}},ExpressionUUID->"e37b2821-9602-418e-8ee8-\
90fbec2d391e"],

Cell[CellGroupData[{

Cell[TextData[{
 "Under a null hypothesis the population odds ratio would be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aee1ecbf-8d99-43a5-b8de-35037722ac8d"],
 " and the claim (alternative hypothesis) would be that it is not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0529ea6b-61da-4181-b233-55179ced3dec"]
}], "Item",
 CellChangeTimes->{{4.002189107107477*^9, 4.002189125644368*^9}, {
  4.0021891604034*^9, 4.00218917964765*^9}, {4.002190083148653*^9, 
  4.002190119270585*^9}, {4.0022069300605307`*^9, 
  4.0022069318747187`*^9}},ExpressionUUID->"d05ba4bb-a3e5-420e-8971-\
5bfb002f849b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "the", " ", "confidence", " ", "coefficient"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"InverseCDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", ".975"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "standard", " ", "error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seOREstimate", "=", 
     RowBox[{"N", "[", 
      SqrtBox[
       RowBox[{
        FractionBox["1", "101"], "+", 
        FractionBox["1", "23"], "+", 
        FractionBox["1", "21"], "+", 
        FractionBox["1", "98"]}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "log", " ", "confidence", " ", "interval"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"lbLogOR", "=", 
    RowBox[{
     RowBox[{"Log", "[", "orEstimate", "]"}], "-", 
     RowBox[{"(", 
      RowBox[{"c", " ", "seOREstimate"}], ")"}]}]}], 
   RowBox[{"(*", 
    RowBox[{"Lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ubLogOR", "=", 
    RowBox[{
     RowBox[{"Log", "[", "orEstimate", "]"}], "+", 
     RowBox[{"(", 
      RowBox[{"c", " ", "seOREstimate"}], ")"}], 
     RowBox[{"(*", 
      RowBox[{"Upper", " ", "bound"}], "*)"}]}]}]}]}]], "Input",
 CellChangeTimes->{{4.002188699550836*^9, 4.002188830574787*^9}, {
  4.0021888809643*^9, 4.0021889571001368`*^9}, {4.002189031417025*^9, 
  4.002189039801963*^9}, {4.002190136896912*^9, 4.002190216577585*^9}, {
  4.002190284227343*^9, 4.002190292254078*^9}, {4.0022066338617573`*^9, 
  4.002206722666752*^9}, {4.002206805694016*^9, 4.00220680605295*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"67533219-4f21-4122-948c-62364f0ef555"],

Cell[BoxData["2.3664817425085958`"], "Output",
 CellChangeTimes->{4.002383317384716*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"1d347d4e-948e-4d48-9360-b26514444e4a"],

Cell[BoxData["3.673660941209922`"], "Output",
 CellChangeTimes->{4.0023833173862543`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"872ac6a6-9f9e-42b7-bacc-6e3ddce7236a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We have to exponentiate (anti-logarithm) these bounds (=EXP(2.36648))\
\>", "Item",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.0021890899504337`*^9}, {
  4.002190230406211*^9, 4.002190247971553*^9}, {4.002383339183752*^9, 
  4.002383350683855*^9}},ExpressionUUID->"f6763205-460b-4b5f-a315-\
412d0536f240"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "exponential", " ", "of", " ", "the", " ", 
    "lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "lbLogOR"], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "exponential", " ", "of", " ", "the", " ", 
     "upper", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   SuperscriptBox["\[ExponentialE]", "ubLogOR"]}]}]], "Input",
 CellChangeTimes->{{4.002190258897173*^9, 4.0021903157895412`*^9}, {
  4.002206753989628*^9, 4.002206760103559*^9}, {4.0022067939011583`*^9, 
  4.002206799797854*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"8a1606b6-37bd-4567-bf5c-2c3c29a42d35"],

Cell[BoxData["10.659822232880012`"], "Output",
 CellChangeTimes->{4.0023833315872583`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"8881cfcb-b37a-41ac-b33f-0721f69c7f18"],

Cell[BoxData["39.395868137966225`"], "Output",
 CellChangeTimes->{4.0023833315886707`*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"ddd36580-4003-4b20-8123-6e15b4fde625"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["95", TraditionalForm], "errors" -> {}, "input" -> 
     "95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd399f7d-b1e7-42c8-be5e-bcbf852bdfe1"],
 "% confident that the true population odds ratio is between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["10.66", TraditionalForm], "errors" -> {}, "input" -> 
     "10.66", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4372e138-5a4a-46f8-953f-fed01666202f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["39.40", TraditionalForm], "errors" -> {}, "input" -> 
     "39.40", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eead402f-47d4-4bc2-830f-6711f8d0e88f"]
}], "Item",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.0021890899504337`*^9}, {
  4.002190334104097*^9, 4.002190367060975*^9}, {4.002206819010702*^9, 
  4.0022068205875196`*^9}, {4.002383366573511*^9, 
  4.002383366838933*^9}},ExpressionUUID->"44a78baf-9fa1-48e0-b124-\
54488b4fbfd9"],

Cell["\<\
Since the population odds under the null hypothesis is NOT in this interval, \
we reject the null hypothesis and support the alternative hypothesis\
\>", "Subitem",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.002189091430017*^9}, {
  4.0021891333*^9, 4.002189192068952*^9}, {4.002190378474248*^9, 
  4.002190395909396*^9}, {4.002206847990657*^9, 
  4.002206848593727*^9}},ExpressionUUID->"c8a8e716-be1f-4eda-bc58-\
975e1f7dbb82"]
}, Open  ]],

Cell[TextData[{
 "We can also express these bounds as percentages with a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["95", TraditionalForm], "errors" -> {}, "input" -> 
     "95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0635033-10d5-4e4a-b0e5-f935933ae693"],
 "% confidence interval of between ",
 Cell[BoxData[
  FormBox["966", TraditionalForm]],ExpressionUUID->
  "82e89bb5-77d5-46ec-a413-de67a2b896db"],
 "% and ",
 Cell[BoxData[
  FormBox["3840", TraditionalForm]],ExpressionUUID->
  "84122fdc-74e9-4105-938d-9015c6db56eb"],
 "% increase in risk"
}], "Item",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.002189091430017*^9}, {
  4.0021891333*^9, 4.002189192068952*^9}, {4.002190378474248*^9, 
