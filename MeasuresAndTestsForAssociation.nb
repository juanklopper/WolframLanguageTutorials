Cell[CellGroupData[{

Cell["RISK DIFFERENCE", "Subsection",
 CellChangeTimes->{{4.002203952008975*^9, 
  4.002203954436098*^9}},ExpressionUUID->"b285e4d0-4df9-4f71-a025-\
55208d8f6c89"],

Cell[CellGroupData[{

Cell[TextData[{
 "We simulate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "186d1fb1-1cbc-4017-813d-7fe38c973ee2"],
 " repeated experiments (creating ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50a9d1c8-e1b0-44fc-bf60-810838b57510"],
 " contingency tables), taking a sample size of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "200"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=200", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2fe5aff7-61b4-46d2-b234-7335da6fe969"],
 " each"
}], "Item",
 CellChangeTimes->{{4.002204675027001*^9, 
  4.002204742751869*^9}},ExpressionUUID->"be0f7808-189d-4afc-83b5-\
eaafd4197b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulate", " ", "1000", " ", "contingency", " ", "tables", " ", "of", " ",
     "size", " ", "200"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"simTables", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"MultinomialDistribution", "[", 
       RowBox[{"sampleSize", ",", "cellProbs"}], "]"}], ",", 
      "numSimulations"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022047089283323`*^9, 4.0022047146892757`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"ae494f82-2b33-47bc-8c3a-f1073e74035f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We calculate the estimated risk difference for each of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec109f27-7591-42ff-92fc-87f374c3c034"],
 " contingency tables"
}], "Item",
 CellChangeTimes->{{4.002204752412877*^9, 
  4.0022047731877127`*^9}},ExpressionUUID->"f2a657e0-6eb6-4137-802f-\
8ff873871c9f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "Risk", " ", 
    RowBox[{"Difference", ":", " ", 
     RowBox[{
      RowBox[{"n11", "/", 
       RowBox[{"(", 
        RowBox[{"n11", " ", "+", " ", "n12"}], ")"}]}], " ", "-", " ", 
      RowBox[{"n21", "/", 
       RowBox[{"(", 
        RowBox[{"n21", " ", "+", " ", "n22"}], ")"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"riskDifferencesMultinomial", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "+", 
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}], ")"}]}], "&"}], ",", 
      RowBox[{"N", "[", "simTables", "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022040703938723`*^9, 4.002204084880093*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"77508762-3803-49de-9417-fa9f73e6d305"]
}, Open  ]],

