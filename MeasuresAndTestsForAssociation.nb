Cell[CellGroupData[{

Cell["RISK DIFFERENCE", "Subsection",
 CellChangeTimes->{{4.002187618024027*^9, 
  4.00218762076897*^9}},ExpressionUUID->"9a6dc92c-d83e-4794-8df2-\
639ce086c453"],

Cell["Difference in conditional probabilities", "Item",
 CellChangeTimes->{{4.0021879817371187`*^9, 
  4.002187988937594*^9}},ExpressionUUID->"256c0978-4aa6-4a4b-a560-\
7e567c4635d5"],

Cell[BoxData[
 RowBox[{
  OverscriptBox["RD", "^"], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", "E"}], ")"}]}], "-", 
    RowBox[{
     OverscriptBox["P", "^"], 
     RowBox[{"(", 
      RowBox[{"D", "|", 
       OverscriptBox["E", "_"]}], ")"}]}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["101", "124"], "-", 
     FractionBox["21", "119"]}], "\[TildeTilde]", 
    ".638"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002190483313302*^9, 4.0021905267817593`*^9}, 
   4.002190633292449*^9},ExpressionUUID->"00e7f48d-c2b4-48a0-819f-\
92a02aeb0b44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Confirm", " ", "the", " ", "calculation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pde", "=", 
     FractionBox["101", "124"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pdne", "=", 
     FractionBox["21", "119"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"rdEstimate", "=", 
    RowBox[{"N", "[", 
     RowBox[{"pde", "-", "pdne"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002188279119171*^9, 4.002188296531644*^9}, {
  4.0021887168265667`*^9, 4.002188719436907*^9}, {4.00218884080585*^9, 
  4.002188872498878*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"c64005d4-421b-4db0-b3b4-9d40f5efb914"],

Cell[BoxData["0.638045540796964`"], "Output",
 CellChangeTimes->{4.0023821956567698`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"65ff65dd-f0ad-401f-a056-c736274b3cea"]
}, Open  ]],

Cell[TextData[{
 "The estimated risk of disease in the exposed is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["63.8", TraditionalForm], "errors" -> {}, "input" -> 
     "63.8", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c55b7f8b-3334-4471-98c8-e521182f7458"],
 " percentage points higher than the estimated risk of disease in the \
unexposed / Exposure increases the risk of disease by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["63.8", TraditionalForm], "errors" -> {}, "input" -> 
     "63.8", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "499262e1-2800-41ef-9b4d-21225d571269"],
 " percentage point compared to non-exposure"
}], "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.002188434462512*^9}, {
  4.002206329913375*^9, 4.0022063446575527`*^9}, {4.002356455121703*^9, 
  4.0023564579714203`*^9}},ExpressionUUID->"2dde4c25-eb16-4977-ba86-\
b3989f63cfb3"],

Cell[TextData[{
 "We can calculate confidence intervals, given that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["RD", "^"], "\[Tilde]", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             SuperscriptBox["1", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\widehat{\\text{RD}} \\sim N \\left( 0,1^{2} \\right)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b49c52a3-d4c5-4663-8122-50991b6c2792"],
 " and where where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "1.96"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c=1.96", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4177028e-edcc-429f-8813-ba77779ea5c6"],
 " is the confidence coefficient for a confidence level of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", ".95"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L=.95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66dc116e-3519-4681-889b-1cfca64d17cb"]
}], "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.0021884439717417`*^9}, {
  4.002188594531001*^9, 4.002188614674968*^9}, {4.002188648110002*^9, 
  4.002188672018972*^9}},ExpressionUUID->"42c673db-4717-4735-89d1-\
6ef0a66ceffd"],

Cell[BoxData[
 RowBox[{
  OverscriptBox["RD", "^"], "\[PlusMinus]", 
  RowBox[{"c", 
   SqrtBox[
    RowBox[{
     FractionBox[
      RowBox[{
       FractionBox[
        SubscriptBox["n", "11"], 
        SubscriptBox["n", 
         RowBox[{"1", "+"}]]], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          SubscriptBox["n", "11"], 
          SubscriptBox["n", 
           RowBox[{"1", "+"}]]]}], ")"}]}], 
      SubscriptBox["n", 
       RowBox[{"1", "+"}]]], "+", 
     FractionBox[
      RowBox[{
       FractionBox[
        SubscriptBox["n", "21"], 
        SubscriptBox["n", 
         RowBox[{"2", "+"}]]], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          SubscriptBox["n", "21"], 
          SubscriptBox["n", 
           RowBox[{"2", "+"}]]]}], ")"}]}], 
      SubscriptBox["n", 
       RowBox[{"2", "+"}]]]}]]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002188512685375*^9, 
  4.002188586730968*^9}},ExpressionUUID->"3ec44f44-a89b-40e1-be2f-\
377d0ebfdd70"],

Cell[CellGroupData[{

Cell[TextData[{
 "Under a null hypothesis, the population risk difference would be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0", TraditionalForm], "errors" -> {}, "input" -> "0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4c8f569-3df9-416b-944a-673af3daf773"],
 " percentage points and the claim (alternative hypothesis) would be that it \
is not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0", TraditionalForm], "errors" -> {}, "input" -> "0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9196ad3a-e541-4843-a8e5-a551d96a760e"],
 " percentage point"
}], "Item",
 CellChangeTimes->{{4.002189107107477*^9, 4.002189125644368*^9}, {
  4.0021891604034*^9, 4.00218917964765*^9}, {4.00235648305547*^9, 
  4.0023564902544613`*^9}},ExpressionUUID->"f2717586-48e1-47f0-909c-\
02b4f43a8c5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "the", " ", "confidence", " ", "coefficient"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"InverseCDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", ".975"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "standard", " ", "error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seRDEstimate", "=", 
     RowBox[{"N", "[", 
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"pde", 
          RowBox[{"(", 
           RowBox[{"1", "-", "pde"}], ")"}]}], "124"], "+", 
        FractionBox[
         RowBox[{"pdne", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "pdne"}], ")"}]}], "119"]}]], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "confidence", " ", "interval"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"rdEstimate", "-", 
    RowBox[{"(", 
     RowBox[{"c", " ", "seRDEstimate"}], ")"}]}], 
   RowBox[{"(*", 
    RowBox[{"Lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"rdEstimate", "+", 
    RowBox[{"(", 
     RowBox[{"c", " ", "seRDEstimate"}], ")"}], 
    RowBox[{"(*", 
     RowBox[{"Upper", " ", "bound"}], "*)"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002188699550836*^9, 4.002188830574787*^9}, {
  4.0021888809643*^9, 4.0021889571001368`*^9}, {4.002189031417025*^9, 
  4.002189039801963*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"12618293-5d37-4e8b-8100-fd8e2dc957ec"],

