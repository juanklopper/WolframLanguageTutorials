  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["4.62", TraditionalForm], "errors" -> {}, "input" -> 
     "4.62", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b94cb70-4c30-4b55-b563-2bf3e0be71d9"],
 " times the estimated risk of disease in the unexposed"
}], "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.002188434462512*^9}, {
  4.002189608463163*^9, 4.002189630755686*^9}, {4.0021899142455053`*^9, 
  4.00218992417625*^9}, {4.002206295125119*^9, 
  4.002206316768777*^9}},ExpressionUUID->"166ceeae-6c3c-4337-8f8e-\
d9f718526998"],

Cell["A simple derivation can express this as a percentage", "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.002188434462512*^9}, {
  4.002189608463163*^9, 
  4.002189639932891*^9}},ExpressionUUID->"d37d5429-1bcd-450b-a958-\
5dcf706ff4be"],

Cell[BoxData[{
 RowBox[{
  FractionBox[
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", "E"}], ")"}]}], 
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}]], "=", "4.62"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{"4.62", 
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", 
     OverscriptBox["E", "_"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", "3.62"}], ")"}], 
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", 
     OverscriptBox["E", "_"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["P", "^"], 
   RowBox[{"(", 
    RowBox[{"D", "|", "E"}], ")"}]}], "=", 
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}], "+", 
   RowBox[{"3.62", 
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}]}]}]}], "DisplayFormula",
 CellChangeTimes->{{4.0021896522695*^9, 
  4.002189784795203*^9}},ExpressionUUID->"3853c1f4-d2a3-41f1-ad84-\
cece8bd38dbc"],

Cell[TextData[{
 "The risk of disease in the exposed is ",
