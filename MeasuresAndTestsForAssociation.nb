Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Visualize", " ", "the", " ", "null", " ", "distribution"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"Log", "[", "relativeRisksMultinomial", "]"}], ",", "Automatic",
       ",", "\"\<PDF\>\"", ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Natural Logarithm of Estimated Relative Risks\>\"", ",", 
         "16"}], "]"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
