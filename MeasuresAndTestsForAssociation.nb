    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0c51d5e-4fb4-4ade-9c43-880d6d2322d9"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         OverscriptBox[
          StyleBox["D", "TI"], "_"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P \\left( \\bar{D} \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85c39044-22fb-4da4-adf8-61237824e621"],
 " is not random)"
}], "Item",
 CellChangeTimes->{{4.0022070649721727`*^9, 4.002207139599103*^9}, {
