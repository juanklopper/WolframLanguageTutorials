Cell[CellGroupData[{

Cell["RELATIVE RISK", "Subsection",
 CellChangeTimes->{{4.002204890133511*^9, 
  4.002204900930752*^9}},ExpressionUUID->"1cdbf0d1-9242-4a45-a2bb-\
4b6d6e6bec6b"],

Cell[CellGroupData[{

Cell[TextData[{
 "We simulate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4325323-606b-433a-b189-550ef421993b"],
 " repeated experiments (creating ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8499170-5661-40e8-a9e9-5e249aeedae9"],
 " contingency tables), taking a sample size of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "200"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=200", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13c32442-75c3-40e8-aa4c-f7559ef05ddf"],
 " each"
}], "Item",
 CellChangeTimes->{{4.002204675027001*^9, 
  4.002204742751869*^9}},ExpressionUUID->"13d9a411-8f01-4585-8092-\
b2aaab27d78b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulate", " ", "1000", " ", "contingency", " ", "tables", " ", "of", " ",
     "size", " ", "200"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"simTables", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"MultinomialDistribution", "[", 
       RowBox[{"sampleSize", ",", "cellProbs"}], "]"}], ",", 
      "numSimulations"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022047089283323`*^9, 4.0022047146892757`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"1f491483-3e6f-4560-9c1d-0a0fa22a4115"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We calculate the estimated relative risk for each of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc119507-6c94-4cb7-bdaa-a690e4e8799e"],
 " contingency tables"
}], "Item",
 CellChangeTimes->{{4.002204752412877*^9, 4.0022047731877127`*^9}, {
  4.002204942676816*^9, 
  4.002204947882579*^9}},ExpressionUUID->"9266f9cc-922e-447e-8560-\
820068610f96"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "relative", " ", 
    RowBox[{"risk", ":", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n11", "/", 
        RowBox[{"(", 
         RowBox[{"n11", " ", "+", " ", "n12"}], ")"}]}], ")"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"n21", "/", 
        RowBox[{"(", 
         RowBox[{"n21", " ", "+", " ", "n22"}], ")"}]}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"relativeRisksMultinomial", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "+", 
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}], ")"}]}], "&"}], ",", 
      RowBox[{"N", "[", "simTables", "]"}]}], "]"}]}], ";"}]}]], "Input",
