2e1f4fb22d27"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "In case-control studies, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         StyleBox["D", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P \\left( D \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "525aa011-c223-4e15-ae17-db95eaf7426c"],
 " is not random (hence ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "-", 
         StyleBox["P", "TI"], 
         RowBox[{"(", "D", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
