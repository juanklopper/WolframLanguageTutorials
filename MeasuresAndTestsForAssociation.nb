  4.002189226057469*^9}},ExpressionUUID->"38e72a03-526a-41e5-b866-\
c2ee2d35a434"],

Cell[BoxData[{
 RowBox[{
  OverscriptBox["RR", "^"], "=", 
  FractionBox[
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", "E"}], ")"}]}], 
   RowBox[{
    OverscriptBox["P", "^"], 
    RowBox[{"(", 
     RowBox[{"D", "|", 
      OverscriptBox["E", "_"]}], ")"}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  OverscriptBox["RR", "^"], "=", 
  RowBox[{
   FractionBox[
    FractionBox["101", "124"], 
    FractionBox["21", "119"]], "\[TildeTilde]", 
   "4.626"}]}]}], "DisplayFormula",
 CellChangeTimes->{{4.002189334556059*^9, 4.002189411653822*^9}, {
  4.002189728133142*^9, 4.002189735028491*^9}, {4.002382529980838*^9, 
  4.002382530114996*^9}},ExpressionUUID->"5e9030ef-ad7e-4e12-8cfe-\
abd47c96ac79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Confirm", " ", "the", " ", "calculation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pde", "=", 
     FractionBox["101", "124"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pdne", "=", 
     FractionBox["21", "119"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"rrEstimate", "=", 
    RowBox[{"N", "[", 
     FractionBox["pde", "pdne"], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002188279119171*^9, 4.002188296531644*^9}, {
  4.0021887168265667`*^9, 4.002188719436907*^9}, {4.00218884080585*^9, 
