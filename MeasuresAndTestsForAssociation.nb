  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["4.62", TraditionalForm], "errors" -> {}, "input" -> 
     "4.62", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc249aa7-6967-4249-94ea-75352b8094b8"],
 " times the risk of disease in the unexposed / Exposure increases the risk \
of disease by ",
 Cell[BoxData[
  FormBox[
