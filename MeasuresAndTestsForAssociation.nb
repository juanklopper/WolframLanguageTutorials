          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Density\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "3", ",", 
