Cell[CellGroupData[{

Cell["ODDS RATIO", "Subsection",
 CellChangeTimes->{{4.002204890133511*^9, 4.002204900930752*^9}, {
  4.0022053563780403`*^9, 
  4.002205359390532*^9}},ExpressionUUID->"52af9fb0-45ed-4766-9636-\
432fc5d3393a"],

Cell[CellGroupData[{

Cell[TextData[{
 "We simulate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8eb1443-0fe1-4f3c-8899-0a828b90224e"],
 " repeated experiments (creating ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb2499c3-4d54-4a78-a8a6-ed38eb2a77ac"],
 " contingency tables), taking a sample size of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "200"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=200", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8e32d91b-051b-41e1-8e63-1c07bff2b313"],
 " each"
}], "Item",
 CellChangeTimes->{{4.002204675027001*^9, 
  4.002204742751869*^9}},ExpressionUUID->"84c7fff9-0af2-44c9-a86c-\
ae651e6b5d2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simulate", " ", "1000", " ", "contingency", " ", "tables", " ", "of", " ",
     "size", " ", "200"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"simTables", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"MultinomialDistribution", "[", 
       RowBox[{"sampleSize", ",", "cellProbs"}], "]"}], ",", 
      "numSimulations"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022047089283323`*^9, 4.0022047146892757`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"c37e4439-a70c-46eb-995b-9470cd00e489"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We calculate the estimated odds ratio for each of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1000", TraditionalForm], "errors" -> {}, "input" -> 
     "1000", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7b29986-80ee-42d6-8dd5-ce3fe37ea39a"],
 " contingency tables"
}], "Item",
 CellChangeTimes->{{4.002204752412877*^9, 4.0022047731877127`*^9}, {
  4.002204942676816*^9, 4.002204947882579*^9}, {4.002205370592937*^9, 
  4.002205372166952*^9}},ExpressionUUID->"052aca00-07c3-4abf-9ec7-\
995ea62aa006"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "odds", " ", 
    RowBox[{"ratios", ":", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n11", " ", "n22"}], ")"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"n12", " ", "n21"}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"oddsRatiosMultinomial", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], ")"}], "&"}], ",", 
      RowBox[{"N", "[", "simTables", "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022040703938723`*^9, 4.002204084880093*^9}, {
  4.002204953974588*^9, 4.002205022105845*^9}, {4.002205377629139*^9, 
  4.002205479223671*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"52634429-4c2a-4938-bfd3-2cfe7c84f966"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "A density histogram visualizes the distribution of the ",
 Cell[BoxData[
  FormBox["1000", TraditionalForm]],ExpressionUUID->
  "796d6f0e-003b-464e-89b7-f11da1794181"],
 " simulated, log-transformed, estimated odds ratios"
}], "Item",
 CellChangeTimes->{{4.002204783540781*^9, 4.0022048104707747`*^9}, {
  4.0022050317359257`*^9, 4.002205032450617*^9}, {4.0022054878675327`*^9, 
  4.0022054885120564`*^9}, {4.002357420580364*^9, 
  4.0023574240432453`*^9}},ExpressionUUID->"df3efdf6-48c9-4a5d-aafa-\
b591a5107015"],

Cell[CellGroupData[{

Cell["A normal distribution model is added to the visualization", "Subitem",
 CellChangeTimes->{{4.002204783540781*^9, 
  4.0022048717823753`*^9}},ExpressionUUID->"1553e0ce-22a9-4e86-bd4a-\
d3d491793a44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Visualize", " ", "the", " ", "null", " ", "distribution"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"Log", "[", "oddsRatiosMultinomial", "]"}], ",", "Automatic", 
      ",", "\"\<PDF\>\"", ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Natural Logarithm of Estimated Odds Ratios\>\"", ",", 
         "16"}], "]"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Log of Estimated Odds Ratio\>\"", ",", "14"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Density\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", 
           FractionBox["7", "5"], ",", 
           FractionBox["1", "5"]}], "]"}]}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"Log", "[", "oddsRatiosMultinomial", "]"}], "]"}], ",", 
          RowBox[{"StandardDeviation", "[", 
           RowBox[{"Log", "[", "oddsRatiosMultinomial", "]"}], "]"}]}], "]"}],
         ",", "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        FractionBox[
         RowBox[{"-", "3"}], "2"], ",", 
        FractionBox["3", "2"]}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002204135374037*^9, 4.00220414914361*^9}, {
  4.002204181485291*^9, 4.002204337336727*^9}, {4.002204378492134*^9, 
