 Cell[BoxData[
  FormBox["362", TraditionalForm]],ExpressionUUID->
  "df1a5385-d139-46b5-99c1-25b9857eaa71"],
 " participants to receive either one of two active interventions or a \
placebo in a population of adults with hypertension"
}], "Item",
