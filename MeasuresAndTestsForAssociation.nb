Cell[TextData[{
 "Given that events ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ff4d609-8256-4332-b0d2-80489cabfca0"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> "B", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9ea8bd7-bc99-4e7c-b75f-5b54e166c4d8"],
 " are independent we have that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], "\[Intersection]", 
             StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           StyleBox["B", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "P \\left( A \\cap B \\right) = P \\left( A \\right) P \\left ( B \
\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2977c913-5e5d-469e-b4ef-5bcbfa16e968"]
}], "Subsubitem",
