  4.002189903445146*^9}},ExpressionUUID->"e6a81aac-3629-4fb3-9518-\
add564d428f8"],

Cell[CellGroupData[{

Cell[TextData[{
 "We can calculate confidence intervals where where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "1.96"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c=1.96", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d872518-a354-4c50-9b26-69514bec2565"],
 " is the confidence coefficient for a confidence level of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", ".95"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L=.95", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ea0c3b7-2b32-454f-8985-21b32dd5ad7a"]
}], "Item",
 CellChangeTimes->{{4.002188315582061*^9, 4.0021884439717417`*^9}, {
  4.002188594531001*^9, 4.002188614674968*^9}, {4.002188648110002*^9, 
  4.002188672018972*^9}, {4.002189977428075*^9, 
  4.002189982096168*^9}},ExpressionUUID->"acccc9f8-1d9d-43a3-9fa7-\
2232c70d706d"],

Cell["\<\
Unfortunately the estimated relative risk is not normally distributed and we \
have to perform a log transformation\
\>", "Subitem",
 CellChangeTimes->{{4.002188315582061*^9, 4.0021884439717417`*^9}, {
  4.002188594531001*^9, 4.002188614674968*^9}, {4.002188648110002*^9, 
  4.002188672018972*^9}, {4.002189977428075*^9, 
  4.0021900049663887`*^9}},ExpressionUUID->"73f44564-2593-4187-929c-\
8e26cf18d808"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ln", 
   RowBox[{"(", 
    OverscriptBox["RR", "^"], ")"}]}], "\[PlusMinus]", 
  RowBox[{"c", 
   SqrtBox[
    RowBox[{
     FractionBox[
      SubscriptBox["n", "12"], 
      RowBox[{
       SubscriptBox["n", "11"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["n", "11"], "+", 
         SubscriptBox["n", "12"]}], ")"}]}]], "+", 
     FractionBox[
      SubscriptBox["n", "22"], 
      RowBox[{
       SubscriptBox["n", "21"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["n", "21"], "+", 
         SubscriptBox["n", "22"]}]}]}]]}]]}]}]], "DisplayFormula",
 CellChangeTimes->{{4.002188512685375*^9, 4.002188586730968*^9}, {
  4.002190011311611*^9, 
  4.002190071362475*^9}},ExpressionUUID->"0c622e5b-04fc-48ac-917f-\
360c748abae6"],

Cell[CellGroupData[{

Cell[TextData[{
 "Under a null hypothesis, the population relative risk would be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9a94943-69e3-49a3-a04d-1610b46cf100"],
 " and the claim (alternative hypothesis) would be that it is not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57ea6544-fce4-4d3e-9dd3-6042c8dcf182"]
}], "Item",
 CellChangeTimes->{{4.002189107107477*^9, 4.002189125644368*^9}, {
   4.0021891604034*^9, 4.00218917964765*^9}, {4.002190083148653*^9, 
   4.002190119270585*^9}, 
   4.0023565619135113`*^9},ExpressionUUID->"3cfe3a7e-4922-47c5-81c9-\
e00eac6d4bdd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "the", " ", "confidence", " ", "coefficient"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"InverseCDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", ".975"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "standard", " ", "error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seRREstimate", "=", 
     RowBox[{"N", "[", 
      SqrtBox[
       RowBox[{
        FractionBox["23", 
         RowBox[{"101", " ", "124"}]], "+", 
        FractionBox["98", 
         RowBox[{"21", " ", "119"}]]}]], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "log", " ", "confidence", " ", "interval"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"lbLogRR", "=", 
    RowBox[{
     RowBox[{"Log", "[", "rrEstimate", "]"}], "-", 
     RowBox[{"(", 
      RowBox[{"c", " ", "seRREstimate"}], ")"}]}]}], 
   RowBox[{"(*", 
    RowBox[{"Lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ubLogRR", "=", 
    RowBox[{
     RowBox[{"Log", "[", "rrEstimate", "]"}], "+", 
     RowBox[{"(", 
      RowBox[{"c", " ", "seRREstimate"}], ")"}], 
     RowBox[{"(*", 
      RowBox[{"Upper", " ", "bound"}], "*)"}]}]}]}]}]], "Input",
 CellChangeTimes->{{4.002188699550836*^9, 4.002188830574787*^9}, {
  4.0021888809643*^9, 4.0021889571001368`*^9}, {4.002189031417025*^9, 
  4.002189039801963*^9}, {4.002190136896912*^9, 4.002190216577585*^9}, {
  4.002190284227343*^9, 4.002190292254078*^9}, {4.002206734186194*^9, 
  4.0022067501592493`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"f05e4849-f04d-48fc-a85a-67773303f6ef"],

Cell[BoxData["1.1323251830786258`"], "Output",
 CellChangeTimes->{4.002382840307082*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"55154b98-ef2a-4c99-9e97-17313880fba2"],

Cell[BoxData["1.9265548301700322`"], "Output",
 CellChangeTimes->{4.002382840308313*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"2c6efe3a-1f7c-464b-9cbb-fb60a05e021d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We have to exponentiate these bounds (inverse of the logarithm)\
\>", "Item",
 CellChangeTimes->{{4.0021890569154863`*^9, 4.0021890899504337`*^9}, {
  4.002190230406211*^9, 4.002190247971553*^9}, {4.002356582973682*^9, 
  4.002356598730358*^9}},ExpressionUUID->"c8226364-bce8-42bf-90ad-\
380cf8db136e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "exponential", " ", "of", " ", "the", " ", 
    "lower", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "lbLogRR"], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "exponential", " ", "of", " ", "the", " ", 
     "upper", " ", "bound"}], "*)"}], "\[IndentingNewLine]", 
   SuperscriptBox["\[ExponentialE]", "ubLogRR"]}]}]], "Input",
 CellChangeTimes->{{4.002190258897173*^9, 4.0021903157895412`*^9}, {
  4.002206753989628*^9, 4.002206760103559*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"33b6d059-1198-4696-9bf4-8a676cfaefc5"],

Cell[BoxData["3.102862843022579`"], "Output",
 CellChangeTimes->{4.002382877146042*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"ff8acd4e-8a68-4835-adc3-1243763544b0"],

