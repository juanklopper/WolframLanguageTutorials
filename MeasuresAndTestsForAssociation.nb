}, Open  ]],

Cell[CellGroupData[{

Cell["OBSERVATIONAL STUDY DESIGN", "Subsection",
 CellChangeTimes->{{4.002207055943056*^9, 4.002207059637476*^9}, {
  4.0023806483800163`*^9, 
  4.002380650839239*^9}},ExpressionUUID->"d62ad63b-6a91-4a22-becd-\
3386bd4b526f"],

Cell[CellGroupData[{

Cell["\<\
For risk difference and relative risk we calculate a conditional probability \
for disease given exposure\
\>", "Item",
 CellChangeTimes->{{4.0022070649721727`*^9, 4.002207096041478*^9}, {
  4.002380845187099*^9, 
  4.002380845188333*^9}},ExpressionUUID->"48256355-90bb-41e9-8c21-\
bd359ab85183"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         RowBox[{
           StyleBox["D", "TI"], "|", 
           StyleBox["E", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P \\left(D| E \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "210b40cb-e879-4760-b69c-9eb73ad9f2d4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         RowBox[{
           StyleBox["D", "TI"], "|", 
           OverscriptBox[
            StyleBox["E", "TI"], "_"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P \\left( D | \\bar{E} \\right)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1eff773-c9c1-4d66-b436-f1d7378b511e"]
}], "Subitem",
 CellChangeTimes->{{4.0022070649721727`*^9, 4.002207096041478*^9}, {
  4.002380845864706*^9, 
  4.002380858313582*^9}},ExpressionUUID->"1839b674-32fd-4504-a749-\
ba83485398fb"]
}, Open  ]],

Cell["Disease must be random", "Item",
 CellChangeTimes->{{4.0022070649721727`*^9, 4.002207102840667*^9}, {
  4.002383559909882*^9, 
  4.002383563045899*^9}},ExpressionUUID->"cf219ed3-2356-4696-b236-\
f36c1abfd006"],

Cell[CellGroupData[{

Cell[TextData[{
 "In cross-sectional and cohort studies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         StyleBox["D", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P \\left( D \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "273fb8a0-0f05-41b8-8edf-d0fe4adf1e73"],
 " is random"
}], "Item",
