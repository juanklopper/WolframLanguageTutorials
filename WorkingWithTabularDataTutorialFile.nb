Cell[CellGroupData[{

Cell[" Combine the previous two column operations", "Subitem",
 CellChangeTimes->{{4.000813053552723*^9, 4.0008130649544907`*^9}, 
   4.000813306834854*^9},ExpressionUUID->"bf37d4e3-1c06-41aa-9c00-\
e1533102fc40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Combine", " ", "the", " ", "addition", " ", "of", " ", "the", " ", "two", 
    " ", "new", " ", "columns", " ", "above"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"TransformColumns", "[", 
   RowBox[{"tab", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<weight_kg\>\"", ",", 
      RowBox[{"\"\<WeightClass\>\"", "->", 
       RowBox[{"Function", "[", 
        RowBox[{"#\"weight_kg\"", ">=", "50"}], "]"}]}], ",", 
      RowBox[{"\"\<weight_lbs\>\"", "->", 
       RowBox[{"Function", "[", 
        RowBox[{"#\"weight_kg\"", " ", "2.21"}], "]"}]}]}], "}"}]}], 
