Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Vertical", " ", 
    RowBox[{"(", "default", ")"}], " ", "distribution", " ", "chart", " ", 
    "of", " ", "age", " ", "by", " ", "sex"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{"DistributionChart", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PivotToColumns", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"\"\<sex\>\"", "->", "\"\<age_months\>\""}]}], "]"}], "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Male\>\"", ",", "\"\<Female\>\""}], "}"}]}], ",", 
