Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "a", " ", "new", " ", "column", " ", "named", " ", 
    "WeighClass", " ", "with", " ", "True", " ", "if", " ", "weight_kg", " ", 
    "is", " ", "at", " ", "least", " ", "50", " ", "and", " ", "False", " ", 
    "if", " ", "not"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"TransformColumns", "[", 
   RowBox[{"tab", ",", 
    RowBox[{"\"\<WeightClass\>\"", "->", 
     RowBox[{"Function", "[", 
      RowBox[{"#\"weight_kg\"", ">=", "50"}], "]"}]}]}], "]"}]}]], "Input",
