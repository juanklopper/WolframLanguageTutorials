       RowBox[{"Style", "[", 
        RowBox[{"\"\<Frequency\>\"", ",", "12"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotLabels", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Male\>\"", ",", "\"\<Female\>\""}], "}"}]}], ",", 
