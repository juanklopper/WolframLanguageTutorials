Cell[CellGroupData[{

Cell[TextData[{
 "Standardize the values of a column using the ",
 StyleBox["ColumnwiseValue", "CodeText"],
 " function to generate a new column named ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["StandardizedWeight", "MR"], TraditionalForm], "errors" -> {},
      "input" -> "\\texttt{StandardizedWeight}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f328004-f3e8-4672-9f80-c4e430129f81"]
}], "Item",
 CellChangeTimes->{{4.000814067548218*^9, 4.0008140948310213`*^9}, {
  4.000831223342664*^9, 
  4.000831234697607*^9}},ExpressionUUID->"be8c669a-25da-453e-b611-\
510884b6a021"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Standardize", " ", "the", " ", "wight_kg", " ", "column", " ", "and", " ",
     "add", " ", "the", " ", "values", " ", "as", " ", "a", " ", "new", " ", 
    "columns", " ", "named", " ", "StandardizedWeight", " ", "after", " ", 
    "the", " ", "weight_kg", " ", "column"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"TransformColumns", "[", 
   RowBox[{"tab", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<weight_kg\>\"", ",", 
      RowBox[{"\"\<StandardizedWeight\>\"", "->", 
       RowBox[{"Function", "[", 
        FractionBox[
         RowBox[{"#\"weight_kg\"", "-", 
          RowBox[{"ColumnwiseValue", "[", 
           RowBox[{"Mean", "[", "#\"weight_kg\"", "]"}], "]"}]}], 
         RowBox[{"ColumnwiseValue", "[", 
          RowBox[{"StandardDeviation", "[", "#\"weight_kg\"", "]"}], "]"}]], 
        "]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0008141120732813`*^9, 4.000814257810603*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"a8a597ac-1185-41f7-a29a-c68a100506ab"],

