Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "the", " ", "Discard", " ", "function", " ", "to", " ", 
    "remove", " ", "all", " ", "rows", " ", "where", " ", "the", " ", 
    "age_group", " ", "is", " ", "adolescent", " ", "and", " ", "then", " ", 
    "only", " ", "show", " ", "the", " ", "patient_id", " ", "and", " ", 
    "age_group", " ", "columns"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Discard", "[", 
    RowBox[{"tab", ",", 
     RowBox[{"Function", "[", 
      RowBox[{"#\"age_group\"", "==", "\"\<adolescent\>\""}], "]"}]}], "]"}], 
   "[", 
   RowBox[{"All", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<patient_id\>\"", ",", "\"\<age_group\>\""}], "}"}]}], 
   "]"}]}]], "Input",
