    "result", " ", "to", " ", "the", " ", "variable", " ", "missing"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"missing", "=", 
   RowBox[{"Tabular", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", 
         RowBox[{"Missing", "[", "]"}], ",", "3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", 
