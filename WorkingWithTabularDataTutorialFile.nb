Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Bar", " ", "chart", " ", "of", " ", "sex", " ", "frequency"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"BarChart", "[", 
   RowBox[{
    RowBox[{"Counts", "[", 
     RowBox[{"tab", "[", 
      RowBox[{"All", ",", "\"\<sex\>\""}], "]"}], "]"}], ",", 
    RowBox[{"LabelingFunction", "->", "Above"}], ",", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Frequency of Genders\>\"", ",", "14"}], "]"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], 
    RowBox[{"(*", 
