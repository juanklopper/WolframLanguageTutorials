Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Select", " ", "only", " ", "Female", " ", "subjects", " ", "from", " ", 
    "the", " ", "sex", " ", "column"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Select", "[", 
   RowBox[{"tab", ",", 
    RowBox[{"Function", "[", 
     RowBox[{"#sex", "==", "\"\<Female\>\""}], "]"}]}], "]"}]}]], "Input",
