727af67e8acc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "stacked", " ", "histogram", " ", "of", " ", "the", " ", 
    "age_months", " ", "column", " ", "for", " ", "each", " ", "of", " ", 
    "the", " ", "categories", " ", "of", " ", "the", " ", "sex", " ", 
    "columns"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Histogram", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PivotToColumns", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"\"\<sex\>\"", "->", "\"\<age_months\>\""}]}], "]"}], "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Male\>\"", ",", "\"\<Female\>\""}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "225", ",", "25"}], "}"}], ",", "Automatic", ",", 
    RowBox[{"ChartLayout", "->", "\"\<Stacked\>\""}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Male\>\"", ",", "\"\<Female\>\""}], "}"}]}], ",", 
    RowBox[{"LabelingFunction", "->", "Above"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "250"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "20"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"5", ",", "20", ",", "5"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000819881868745*^9, 4.000819910679388*^9}, {
