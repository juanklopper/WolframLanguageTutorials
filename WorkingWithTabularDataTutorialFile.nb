Cell[CellGroupData[{

Cell["\<\
Data imputation and interpolation are available for missing data\
\>", "Item",
 CellChangeTimes->{{4.000832346666835*^9, 4.0008323616892033`*^9}, {
  4.0008332853719177`*^9, 
  4.000833293732513*^9}},ExpressionUUID->"3b5652f6-da71-46a3-bc9b-\
d5c8ac58098a"],

Cell[CellGroupData[{

Cell["\<\
Imputation is the general process of replacing missing data points with \
substituted values, while interpolation is a specific technique that \
estimates missing values by constructing new points between known data points\
\
\>", "Subitem",
 CellChangeTimes->{{4.000832346666835*^9, 4.0008323616892033`*^9}, {
  4.0008332853719177`*^9, 
  4.0008332947002277`*^9}},ExpressionUUID->"b75cf168-32a5-4e32-881a-\
a02df6c5231e"],

