       RowBox[{"{", 
        RowBox[{"1", ",", "1.2", ",", "3", ",", "2", ",", "1.3"}], "}"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<ID\>\"", ",", "\"\<A\>\"", ",", "\"\<B\>\"", 
       ",", "\"\<C\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}]}]}]], "Input",
