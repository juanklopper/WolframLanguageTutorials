Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "number", " ", "of", " ", "cases", " ", "of",
     " ", "each", " ", "age", " ", "group", " ", "for", " ", "each", " ", 
    "readmission", " ", "status", " ", "group", " ", "using", " ", "the", " ",
     "PivotToColumns", " ", "function", " ", "and", " ", "assign", " ", "the",
     " ", "result", " ", "to", " ", "the", " ", "variable", " ", 
    "sexReadmissionContingencyTable"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"sexReadmissionContingencyTable", "=", 
   RowBox[{"PivotToColumns", "[", 
    RowBox[{
     RowBox[{"AggregateRows", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"\"\<Frequency\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{"Length", "[", "#sex", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<sex\>\"", ",", "\"\<readmitted_within_7_days\>\""}], 
        "}"}]}], "]"}], ",", 
