   RowBox[{
    RowBox[{"Generate", " ", "a", " ", "box"}], "-", "and", "-", 
    RowBox[{
    "whisker", " ", "plot", " ", "of", " ", "the", " ", "age", " ", 
     "distribution", " ", "of", " ", "males", " ", "and", " ", "females"}]}], 
   "*)"}], "\[IndentingNewLine]", 
