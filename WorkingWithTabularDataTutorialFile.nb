508300a91dcc"],

Cell[CellGroupData[{

Cell[TextData[{
 "We can use the ",
 StyleBox["CastColumns", "CodeText"],
 " function to change the data type of observations in a specific column"
}], "Item",
 CellChangeTimes->{{4.00081680219654*^9, 
  4.000816831339807*^9}},ExpressionUUID->"91704401-b9d1-4d90-a3cd-\
f7567982d910"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Change", " ", "the", " ", "vist_date", " ", "from", " ", "a", " ", 
    "String", " ", "to", " ", "a", " ", "Date", " ", "type", " ", "and", " ", 
    "save", " ", "the", " ", "changes"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"tab", "=", 
   RowBox[{"CastColumns", "[", 
    RowBox[{"tab", ",", 
