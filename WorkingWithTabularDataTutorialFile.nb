Cell[CellGroupData[{

Cell["Values can be imputed based on a distribution", "Item",
 CellChangeTimes->{{4.0008330163673477`*^9, 
  4.000833029702326*^9}},ExpressionUUID->"74edbe90-7f24-4ac3-b67c-\
6011a601b16b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "mean", " ", "and", " ", "the", " ", 
    "standard", " ", "deviation", " ", "of", " ", "values", " ", "in", " ", 
    "column", " ", "A", " ", "and", " ", "assign", " ", "the", " ", "results",
     " ", "to", " ", "the", " ", "variables", " ", "meanA", " ", "and", " ", 
    "stdA"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"meanA", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"DeleteMissing", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"missing", "[", 
        RowBox[{"All", ",", "\"\<A\>\""}], "]"}], "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"stdA", "=", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"DeleteMissing", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"missing", "[", 
        RowBox[{"All", ",", "\"\<A\>\""}], "]"}], "]"}], "]"}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.000832878578741*^9, 4.000833002884346*^9}, {
