Cell[CellGroupData[{

Cell["\<\
A box-and-whisker plot is arguably better suited to visualizing the \
distribution of a numerical variable for different categories of a \
categorical variable\
\>", "Item",
 CellChangeTimes->{{4.0008204248022118`*^9, 4.000820428623077*^9}, {
  4.00082072615627*^9, 
